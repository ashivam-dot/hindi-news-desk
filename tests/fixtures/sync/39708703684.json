 "beats": [
  {
   "text": "जंतर मंतर पर प्रदर्शन के बाद 23 अक्टूबर को देशव्यापी आंदोलन तय किया गया है।",
   "shot": "photo:0/4",
   "card": {
    "big": "23 अक्टूबर विरोध",
    "small": "देशव्यापी आंदोलन"
   },
   "pause_after": 0.3
  },
  {
   "text": "कॉकरोच जनता पार्टी ने जंतर मंतर पर विरोध प्रदर्शन किया था।",
   "shot": "photo:6/4",
   "card": {
    "big": "जंतर मंतर विरोध",
    "small": "पार्टी प्रदर्शन"
   },
   "pause_after": 0.3
  },
  {
   "text": "आयोजकों के मुताबिक मुख्य चुनाव आयुक्त ज्ञानेश कुमार का इस्तीफा मांगा गया है।",
   "shot": "photo:2/1",
   "card": {
    "big": "इस्तीफे की मांग",
    "small": "आयोजकों का बयान"
   },
   "pause_after": 0.3
  },
  {
   "text": "पुलिस के अनुसार कुछ नेताओं को हिरासत में भी लिया गया था।",
   "shot": "photo:3/0",
   "card": {
    "big": "नेताओं की हिरासत",
    "small": "पुलिस कार्रवाई"
   },
   "pause_after": 0.3
  },
  {
   "text": "कोर्ट में मुचलका भरने के बाद नेताओं को रिहा कर दिया गया।",
   "shot": "photo:1/2",
   "card": {
    "big": "मुचलके पर रिहाई",
    "small": "कोर्ट का फैसला"
   },
   "pause_after": 0.3
  },
  {
   "text": "आगे इंडिया ब्लॉक की पार्टियों को भी मार्च में शामिल होने की अपील की गई है।",
   "shot": "photo:3/0",
   "card": {
    "big": "इंडिया ब्लॉक",
    "small": "आगे क्या"
   },
   "pause_after": 0.3
  }
