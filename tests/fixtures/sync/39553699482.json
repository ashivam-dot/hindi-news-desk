{
 "id": "nw-20261019-tiger-shroff-attack-hurt",
 "kind": "explainer",
 "title": "Tiger Shroff: ड्राइवर के हाथ में लगी गोली, खुद गाड़ी चलाकर अस्पताल पहुंचे",
 "beats": [
  {
   "text": "टाइगर श्रॉफ पर फायरिंग में घायल उनके ड्राइवर और फैन अस्पताल में हैं।",
   "shot": "photo:0/1",
   "card": {
    "big": "2 लोग घायल",
    "small": "अस्पताल में भर्ती"
   },
   "pause_after": 0.3
  },
  {
   "text": "यह हमला रविवार को मुम्बई के जुहू में ग्राउंड के बाहर हुआ था।",
   "shot": "photo:9/10",
   "card": {
    "big": "रविवार को फायरिंग",
    "small": "जुहू में फायरिंग"
   },
   "pause_after": 0.3
  },
  {
   "text": "फायरिंग में टाइगर के ड्राइवर फिरदौस इब्राहिम बलोच के हाथ में गोली लगी।",
   "shot": "photo:2/3",
   "card": {
    "big": "हाथ में गोली",
    "small": "ड्राइवर घायल"
   },
   "pause_after": 0.3
  },
  {
   "text": "अभिनेता खुद गाड़ी चलाकर घायल ड्राइवर को Nanavati Hospital लेकर पहुंचे थे।",
   "shot": "photo:12/13",
   "card": {
    "big": "अस्पताल पहुंचाया",
    "small": "टाइगर का कदम"
   },
   "pause_after": 0.3
  },
  {
   "text": "वहीं सीने में गोली लगने से घायल फैन उमेश चौहान KEM Hospital में हैं।",
   "shot": "photo:15/16",
   "card": {
    "big": "सीने में गोली",
    "small": "फैन घायल"
   },
   "pause_after": 0.3
  },
  {
   "text": "डॉक्टरों के मुताबिक दोनों घायलों की हालत स्थिर है और इलाज जारी है।",
   "shot": "photo:8/11",
   "card": {
    "big": "हालत स्थिर",
    "small": "डॉक्टरों का बयान"
   },
   "pause_after": 0.3
  }
 ],
